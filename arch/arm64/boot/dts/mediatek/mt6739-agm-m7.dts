/dts-v1/;

#include "mt6739.dtsi"
#include "mt6357.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/mediatek,mt6357-auxadc.h>

/ {
	model = "AGM M7";
	compatible = "agm,m7", "mediatek,mt6739";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "";
	};

	/* LK looks up "/memory" by exact path and rewrites it. */
	memory {
		device_type = "memory";
		reg = <0 0x40000000 0 0x20000000>;
	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4350000>;
		charge-full-design-microamp-hours = <2500000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		constant-charge-current-max-microamp = <450000>;
		charge-term-current-microamp = <150000>;
		ocv-capacity-celsius = <25>;
		ocv-capacity-table-0 = <4185000 100>, <4124700 95>, <4076100 90>,
				       <4030900 85>, <3980100 80>, <3957200 75>,
				       <3923800 70>, <3895700 65>, <3866500 60>,
				       <3826200 55>, <3806800 50>, <3791600 45>,
				       <3781300 40>, <3774800 35>, <3770400 30>,
				       <3758900 25>, <3741700 20>, <3717300 15>,
				       <3687800 10>, <3667500 5>, <3327000 0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Stock kernel layout: dump zones, then the console zone. */
		ramoops@44410000 {
			compatible = "ramoops";
			reg = <0 0x44410000 0 0x4f000>;
			record-size = <0x1000>;
		};

		/* Used by earlycon=pstoreram. */
		console-ramoops@4445f000 {
			reg = <0 0x4445f000 0 0x40000>;
			no-map;
		};

		connsys_mem: connsys-memory {
			no-map;
			size = <0 0x200000>;
			alignment = <0 0x200000>;
			alloc-ranges = <0 0x40000000 0 0x38000000>;
		};
	};

	/* LK asserts unless its ODM overlay applies, so give it these targets. */
	lk-odm-overlay-sink {
		chosen: chosen {
		};

		odm: odm {
		};

		pio: pio {
		};

		button_bl_gpio: button-bl-gpio {
		};

		i2c1: i2c1 {
		};

		mtkfb: mtkfb {
		};

		accdet: accdet {
		};

		consys: consys {
		};

		i2c2: i2c2 {
		};

		irtx_pwm: irtx-pwm {
		};

		apuart0: apuart0 {
		};

		i2c3: i2c3 {
		};

		wusb3801x: wusb3801x {
		};

		irq_wusb3801x: irq-wusb3801x {
		};

		touch: touch {
		};

		kd_camera_hw1: kd-camera-hw1 {
		};

		flashlights_gpio_dev: flashlights-gpio-dev {
		};

		audgpio: audgpio {
		};

		speaker: speaker {
		};

		tyd_mic_gpio: tyd-mic-gpio {
		};

		msdc1: msdc1 {
		};

		nfc: nfc {
		};

		led_gpio: led-gpio {
		};

		charger: charger {
		};

		auxadc: auxadc {
		};

		pmic_clock_buffer_ctrl: pmic-clock-buffer-ctrl {
		};

		i2c0: i2c0 {
		};

		i2c4: i2c4 {
		};

		i2c5: i2c5 {
		};

		gpio_usage_mapping: gpio-usage-mapping {
		};

		chr_stat: chr-stat {
		};

		irq_nfc: irq-nfc {
		};

		otg_iddig: otg-iddig {
		};

		main_pmic: main-pmic {
		};

		mt_pmic_vcama_ldo_reg: mt-pmic-vcama-ldo-reg {
		};

		mt_pmic_vsim1_ldo_reg: mt-pmic-vsim1-ldo-reg {
		};

		mt_pmic_vsim2_ldo_reg: mt-pmic-vsim2-ldo-reg {
		};

		mt_pmic_vcamd_ldo_reg: mt-pmic-vcamd-ldo-reg {
		};

		mt_pmic_vcamio_ldo_reg: mt-pmic-vcamio-ldo-reg {
		};

		mt_pmic_vldo28_ldo_reg: mt-pmic-vldo28-ldo-reg {
		};

		keypad: keypad {
		};
	};
};

&display {
	width-mm = <37>;
	height-mm = <49>;
	status = "okay";
};

&keyboard {
	keypad,num-rows = <8>;
	keypad,num-columns = <9>;
	linux,keymap = <MATRIX_KEY(0, 1, KEY_F11)
			MATRIX_KEY(3, 3, KEY_MENU)
			MATRIX_KEY(3, 4, KEY_LEFT)
			MATRIX_KEY(3, 5, KEY_2)
			MATRIX_KEY(3, 6, KEY_8)
			MATRIX_KEY(4, 3, KEY_UP)
			MATRIX_KEY(4, 4, KEY_DOWN)
			MATRIX_KEY(4, 5, KEY_4)
			MATRIX_KEY(4, 6, KEY_9)
			MATRIX_KEY(5, 3, KEY_BACK)
			MATRIX_KEY(5, 4, KEY_RIGHT)
			MATRIX_KEY(5, 5, KEY_5)
			MATRIX_KEY(5, 6, KEY_NUMERIC_STAR)
			MATRIX_KEY(6, 3, KEY_ENTER)
			MATRIX_KEY(6, 4, KEY_3)
			MATRIX_KEY(6, 5, KEY_6)
			MATRIX_KEY(6, 6, KEY_0)
			MATRIX_KEY(7, 3, KEY_SEND)
			MATRIX_KEY(7, 4, KEY_1)
			MATRIX_KEY(7, 5, KEY_7)
			MATRIX_KEY(7, 6, KEY_NUMERIC_POUND)>;
	status = "okay";
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-1 = <&mmc0_pins>;
	bus-width = <8>;
	max-frequency = <200000000>;
	vmmc-supply = <&mt6357_vemc_reg>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

&pinctrl {
	mmc0_pins: mmc0-pins {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO38__FUNC_MSDC0_CMD>,
				 <PINMUX_GPIO41__FUNC_MSDC0_DAT0>,
				 <PINMUX_GPIO42__FUNC_MSDC0_DAT1>,
				 <PINMUX_GPIO43__FUNC_MSDC0_DAT2>,
				 <PINMUX_GPIO44__FUNC_MSDC0_DAT3>,
				 <PINMUX_GPIO45__FUNC_MSDC0_DAT4>,
				 <PINMUX_GPIO46__FUNC_MSDC0_DAT5>,
				 <PINMUX_GPIO47__FUNC_MSDC0_DAT6>,
				 <PINMUX_GPIO48__FUNC_MSDC0_DAT7>;
			input-enable;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk-dsl {
			pinmux = <PINMUX_GPIO40__FUNC_MSDC0_CLK>,
				 <PINMUX_GPIO39__FUNC_MSDC0_DSL>;
			drive-strength = <4>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <PINMUX_GPIO49__FUNC_MSDC0_RSTB>;
			drive-strength = <4>;
		};
	};
};

&ap_i2c0 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft6236";
		reg = <0x38>;
		interrupts-extended = <&pinctrl 11 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&pinctrl 51 GPIO_ACTIVE_LOW>;
		vcc-supply = <&mt6357_vldo28_reg>;
		touchscreen-size-x = <240>;
		touchscreen-size-y = <320>;
	};
};

&ap_i2c1 {
	clock-frequency = <100000>;
	status = "okay";

	charger@6a {
		compatible = "halo,hl7005";
		reg = <0x6a>;
		monitored-battery = <&battery>;
	};
};

&connsys {
	memory-region = <&connsys_mem>;
	vcn18-supply = <&mt6357_vcn18_reg>;
	vcn28-supply = <&mt6357_vcn28_reg>;
	vcn33-bt-supply = <&mt6357_vcn33_bt_reg>;
	vcn33-wifi-supply = <&mt6357_vcn33_wifi_reg>;
	status = "okay";
};

&connsys_wifi {
	status = "okay";
};

&gpu {
	status = "okay";
};

&mt6357_rtc {
	mode-recovery = <0x10>;
	mode-bootloader = <0x2000>;
};

&mt6357_pmic {
	interrupts-extended = <&pinctrl 182 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-controller;
	#interrupt-cells = <2>;

	keys {
		/* Same as stock: one-key long-press reset, shortest time. */
		mediatek,long-press-mode = <1>;
		power-off-time-sec = <0>;

		/delete-node/ key-home;
	};

	power-controller {
		compatible = "mediatek,mt6357-pwrc";
	};

	pmic_charger: charger {
		compatible = "mediatek,mt6357-charger";
		io-channels = <&pmic_adc MT6357_AUXADC_BATADC>,
			      <&pmic_adc MT6357_AUXADC_BAT_TEMP>;
		io-channel-names = "vbat", "temp";
		monitored-battery = <&battery>;
	};
};

&mt6357_vdram_reg {
	regulator-always-on;
};

&mt6357_vio28_reg {
	regulator-always-on;
};

&mt6357_vusb33_reg {
	regulator-always-on;
};

&mt6357_vxo22_reg {
	regulator-always-on;
};

&u2phy {
	status = "okay";
};

&usb {
	dr_mode = "peripheral";
	status = "okay";
};

&watchdog {
	mediatek,lk-normal-restart;
};
